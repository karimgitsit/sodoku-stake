# Sodoku Stake Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# WORLDCOIN / WORLD APP
# =============================================================================

# App ID from World Developer Portal (https://developer.worldcoin.org)
# Create a new app and copy the app_id here
NEXT_PUBLIC_APP_ID=app_staging_your_app_id

# API Key from World Developer Portal (for server-side API calls)
# Go to your app settings and generate an API key
# Used for:
# - Payment verification (required for secure payment flow)
# - Push notifications
# ⚠️ KEEP SECRET - only use server-side!
DEV_PORTAL_API_KEY=your-developer-portal-api-key

# Legacy key (keeping for backwards compatibility with notifications code)
WORLD_API_KEY=your-world-api-key

# Platform wallet address - receives entry fees + extra lives
# Acts as a holding account - prizes distributed at midnight, remainder swept to dev wallet
# ⚠️ CRITICAL: Must match the wallet for PAYOUT_WALLET_PRIVATE_KEY below!
NEXT_PUBLIC_PLATFORM_WALLET=0xYourPlatformWalletAddress

# Developer wallet address - YOUR personal revenue wallet
# Receives revenue in TWO ways:
# 1. DIRECTLY: Reveal fees ($0.20) go here immediately when paid
# 2. DAILY SWEEP: Platform fee (20% of entries) swept here at midnight after prizes
# ⚠️ CRITICAL: If not set, reveal fees go to burn address (LOST FOREVER)!
NEXT_PUBLIC_DEVELOPER_WALLET=0xYourDeveloperWalletAddress

# =============================================================================
# SUPABASE (Database)
# =============================================================================

# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project URL (found in API settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key (KEEP SECRET - only use server-side)
# This bypasses Row Level Security - never expose to client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# PRIZE DISTRIBUTION (for distribute-prizes.ts script)
# =============================================================================

# Private key of the platform wallet (to send prize payouts FROM)
# ⚠️ KEEP THIS EXTREMELY SECRET - it controls your funds!
PAYOUT_WALLET_PRIVATE_KEY=your-platform-wallet-private-key

# World Chain RPC URL (for sending transactions on World Chain)
# Public RPC available, or get a free Alchemy key for better performance
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public

# USDC contract address on World Chain
# Note: This is bridged USDC on World Chain mainnet
USDC_CONTRACT_ADDRESS=0x79A02482A880bCE3F13e09Da970dC34db4CD24d1

# =============================================================================
# CRON JOBS / SCHEDULED TASKS
# =============================================================================

# Secret token to authenticate cron job requests
# Generate a random string (e.g., openssl rand -hex 32)
# Used by /api/cron/notifications and /api/cron/distribute
CRON_SECRET=your-random-secret-for-cron-jobs

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Set to 'development' for mock payments/verification and in-memory database
# Set to 'production' for real World App integration and Supabase
NODE_ENV=development

